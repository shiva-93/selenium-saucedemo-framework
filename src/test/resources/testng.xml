<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Suite" parallel="methods" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- Override with -Dbrowser=firefox or suite parameter; ConfigReader also honors -Dbrowser -->
    <parameter name="browser" value="chrome"/>

    <test name="SauceDemo UI Tests" parallel="methods" thread-count="3">
        <classes>
            <class name="com.tests.LoginTest"/>
            <class name="com.tests.ProductsTest"/>
            <class name="com.tests.CartTest"/>
            <class name="com.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
